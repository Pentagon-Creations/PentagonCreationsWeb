# Pentagon Creations - Environment Variables
# Copy this file to .env.local to connect to your real Sanity.io project

# Your Sanity project ID (find in https://sanity.io/manage or running 'sanity init')
VITE_SANITY_PROJECT_ID=qqw884xm

# Sanity dataset (typically "production")
VITE_SANITY_DATASET=production

# Sanity API version (YYYY-MM-DD)
VITE_SANITY_API_VERSION=2024-03-01

# Enable/Disable Sanity CDN (true for faster public cached responses)
VITE_SANITY_USE_CDN=true

# Set to "false" to hide the development fallback banner even if Sanity is not configured
VITE_SHOW_FALLBACK_BANNER=true

